rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Everything below denies direct client writes — the Admin SDK writes freely.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /shortLinks/{id} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /journeys/{id} { allow read, write: if false; }
    match /clickRecords/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /visitorCooldowns/{id} { allow read, write: if false; }
    match /earnings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /withdrawalRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /referrals/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.referrerUid == request.auth.uid);
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if true;   // public read (only safe fields exposed by /api/public/settings)
      allow write: if false;
    }
    match /adPlacements/{id} { allow read, write: if false; }
    match /adminLogs/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}